# Copy this file to .env and fill in your own values. NEVER commit .env
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dronetv_assistant

# Allowed frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:5173

# Long random string used to sign admin tokens
# generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin login for the dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
